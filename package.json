{
  "name": "abnormal-store",
  "version": "1.0.0",
  "private": true,
  "description": "ABNORMAL \u2014 public product catalogue for PC, Android and iOS with manual payment instructions and no customer accounts.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-art.mjs && next build",
    "build:static": "node scripts/fetch-art.mjs && node scripts/static-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "fetch-art": "node scripts/fetch-art.mjs",
    "add-product": "node scripts/add-product.mjs",
    "predev": "node scripts/fetch-art.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@imgly/background-removal": "^1.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
